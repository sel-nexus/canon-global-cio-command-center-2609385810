# Maintenance database connection; application name is configured separately.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
# Application database, provisioned before Alembic migrations.
DB_NAME=canon_cio
# Signing key: replace through deployment secrets before production.
JWT_SECRET=dev-secret-change-in-production-at-least-32-characters
# Session lifetime in minutes.
ACCESS_TOKEN_MINUTES=60
# Comma-separated explicit frontend development origins.
CORS_ORIGINS=http://127.0.0.1:5173
# Maximum pooled connections and additional burst connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Enable only for an intentional development bootstrap account.
SEED_ON_STARTUP=false
# Optional development seed credentials (never production credentials).
SEED_USERNAME=demo
SEED_PASSWORD=dev-demo-change-me
# Test maintenance connection and isolated database prefix; tests never use DB_NAME.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/postgres
TEST_DB_NAME=canon_auth_test
