# Vite development listener port.
DEV_PORT=5173
# Production preview listener used by browser verification.
PREVIEW_PORT=4173
# Browser-test entry URL; its host/port must identify the preview listener.
E2E_BASE_URL=http://127.0.0.1:4173

# Backend origin used by development and preview proxies, never the shipped client.
API_PROXY_TARGET=http://127.0.0.1:8000
# Public API path prefix; slash uses the same origin, not a localhost bundle URL.
VITE_API_BASE_URL=/

# E2E-only settings: export these when invoking test:e2e (config reads process.env).
# Local real PostgreSQL maintenance connection; dummy development credentials only.
TEST_DATABASE_URL=postgresql+psycopg://agent@127.0.0.1:5432/postgres
# Runner adds a unique suffix and refuses product database names.
TEST_DB_NAME=canon_browser_test
E2E_BACKEND_PORT=8001
CHART_HARNESS_PORT=4174
# Dummy test-only value, never a deployment signing secret.
E2E_JWT_SECRET=dummy-browser-test-signing-key-not-for-production
